# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Source video. ~15 GB across 17 files — far too large for git and fully
# reproducible from the course playlist (see scripts/ for the download step).
# Everything DERIVED from the video (transcripts, board frames, OCR) IS
# tracked, so the pipeline can be re-run from the intermediate artefacts
# without re-downloading.
# ---------------------------------------------------------------------------
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.wav
*.m4a

# ---------------------------------------------------------------------------
# Scratch outputs of the ORIGINAL single-run layout, at repo root only.
# These paths are anchored with a leading slash on purpose: the per-lecture
# equivalents under run/lecture_NN/ are real artefacts and ARE tracked.
# ---------------------------------------------------------------------------
/audio/
/board/
/ir/
/latex/
/ocr/
/lecture1/
/lecture2/
/board_corners.json
/board_states.json
/rectified_board.png

# LaTeX build intermediates (tectonic normally cleans these up itself)
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Preprocessed page images for the handwritten notes: derived from
# refs/pesho-stat-1.pdf by scripts/ocr_pesho.py, regenerate rather than track.
/run/pesho/prep/

# The book is compiled inside lectures/ but belongs at the repository root as
# probability-statistics-bg.pdf; both build_lectures.py and check_refs.py move
# it there. Never track a copy left behind by a bare tectonic run.
/lectures/lectures_full.pdf
/lectures/all_lectures.pdf

# ---------------------------------------------------------------------------
# Source corpus — 982 MB of PDFs and phone photographs, plus the original zips.
# Far past what belongs in git, and it is other people's course material. The
# konspekt is the exception: it is a public faculty document and it is the
# spine of the book, so it is tracked.
sources/zips/
sources/di/
sources/temi/
!sources/konspekt/

# Extraction artefacts — 46 MB, and regenerated from sources in minutes by
# scripts/extract_math.py. The evidence, not the deliverable.
run/

# The identity-patched intermediates extract_math.py writes and removes
_identity.pdf

# The konspekt as dropped in the working directory (tracked copy lives in
# sources/konspekt/)
/Konspekt_DI_KN-*.pdf
_preview.html

# Built book and LaTeX intermediates. Regenerated by scripts/build_topics.py.
/darzhaven-izpit-kn.pdf
topics/*.aux
topics/*.log
topics/*.out
topics/*.toc
topics/*.pdf
topics/*.xdv
